# ═════════════════════════════════════════════════════════════════════════════
#  The March 2026 archive (a copy of the V0.2 site) is its own single-page app
#  in this folder. Anything under /March2026/ that is not a real file goes to
#  THIS folder's index.html, not to the main site's. Uploaded as
#  /March2026/.htaccess by `npm run build` (dist/March2026/.htaccess).
# ═════════════════════════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /March2026/

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /March2026/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|\.htaccess)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
